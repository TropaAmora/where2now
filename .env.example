# Database
DATABASE_URL=sqlite:///./where2now.db

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=logs/app.log
LOG_TO_DB=false
LOG_DB_LEVEL=WARNING

# Geocoding
GEOCODER_ENABLED=true
GEOCODER_PROVIDER=nominatim  # or geoapify, google
GEOCODER_TIMEOUT=5.0
GEOCODER_API_KEY=

# Google Maps / Distance Matrix
GOOGLE_MAPS_API_KEY=
GOOGLE_DISTANCE_MATRIX_BASE_URL=https://maps.googleapis.com/maps/api/distancematrix/json
GOOGLE_DISTANCE_MATRIX_TIMEOUT=10.0
GOOGLE_DISTANCE_MATRIX_MAX_RETRIES=2

